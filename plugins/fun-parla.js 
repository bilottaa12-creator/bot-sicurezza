const { eModeratoreOAdmin } = require('../utils');

const FRASI_INFORMATICHE = [
    'Hai provato a spegnerlo e riaccenderlo?',
    'Non ti arrabbiare se mi spengo, anch' vorrei rilassarmi',
    'Non è un bug, è una feature!',
    'Uno, due, tre... infiniti bugs',
    'Stack overflow detected',
    'SEGMENTATION FAULT (core dumped)',
    'L'errore sei tu,non io se non funziono'
    'Sudo make me a sandwich',
    'echo "Il problema è fra tastiera e sedia"',
    'NULL pointer exception in real life',
    'Aggiorna i tuoi driver',
    '404 Soluzione non trovata',
    'Memoria corrotta, ciao.',
    'La rete va giù, la rete va su, nessuno sa cosa stia succedendo',
    'Acceso e spento un sacco di volte',
    'Credo sia un problema di permessi',
    'Hai controllato se è pluggato?',
    'Prova su un browser diverso',
    'Acceso il Wi-Fi?',
    'Sono tutti problemi di Windows',
    'Lo usate male voi, non è il codice'
];

function getFraseRandom() {
    return FRASI_INFORMATICHE[Math.floor(Math.random() * FRASI_INFORMATICHE.length)];
}

function getGuildStore(store, guildId) {
    if (!store[guildId]) store[guildId] = {};
    return store[guildId];
}

module.exports = {
    name: 'fun-parla',

    async onMessage(message, ctx) {
        const { store } = ctx;
        const guildStore = getGuildStore(store, message.guildId);

        // COMANDO PARLA
        if (message.content.trim() === '!parla') {
            if (!eModeratoreOAdmin(message.member)) {
                await message.reply('❌ Solo i Moderatori e gli Amministratori possono usare questo comando.');
                return true;
            }
            guildStore.parlaActive = true;
            await message.reply(`💬 **MODALITÀ PARLA ATTIVATA!** \n\n"${getFraseRandom()}"`);
            return true;
        }

        // COMANDO PARLA-OFF
        if (message.content.trim() === '!parla-off') {
            if (!eModeratoreOAdmin(message.member)) {
                await message.reply('❌ Solo i Moderatori e gli Amministratori possono usare questo comando.');
                return true;
            }
            guildStore.parlaActive = false;
            await message.reply('💬 **MODALITÀ PARLA DISATTIVATA!**');
            return true;
        }

        // SE PARLA ATTIVO, SCRIVI FRASI AD OGNI MESSAGGIO
        if (guildStore.parlaActive) {
            try {
                await message.reply(`💬 "${getFraseRandom()}"`);
            } catch (err) {
                console.error('Errore nel mandare la frase:', err.message);
            }
            return false;
        }

        return false;
    }
};
